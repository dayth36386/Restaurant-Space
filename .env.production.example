# Production settings for docker-compose.prod.yml. Copy to .env.production,
# fill every value, and never commit the filled file. See DEPLOY.md.

# --- Domains (both under one registrable domain so the refresh cookie works) ---
WEB_DOMAIN=example.com
API_DOMAIN=api.example.com
# Let's Encrypt account e-mail for certificate notices.
ACME_EMAIL=admin@example.com

# --- Secrets: generate each with `openssl rand -base64 48` ---
JWT_SECRET=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Database (defaults use the bundled mysql service) ---
MYSQL_DATABASE=restaurant_space
MYSQL_USER=restaurant
# For managed MySQL: host:port, and remove the mysql service from the compose file.
# DB_HOST=db.example.internal:3306

# --- Image storage: Cloudflare R2 (or AWS S3) with a PRIVATE bucket ---
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com and region "auto".
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=restaurant-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mail (password reset) ---
# Example: Resend smtp.resend.com:587, user "resend", password = API key.
SMTP_ADDR=smtp.example.com:587
SMTP_FROM=Restaurant Space <noreply@example.com>
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (port 587) or tls (port 465)
SMTP_TLS=starttls

# --- Google sign-in (optional) ---
# Authorized redirect URI in Google Console: https://WEB_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Map tiles: required for real traffic (OpenStreetMap's free tiles are not) ---
# MapTiler example: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Scalar API docs at /docs (keep false unless protected).
ENABLE_API_DOCS=false
