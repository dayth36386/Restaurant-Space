# Local development only. Use URL-safe credentials for the migration DSN.
MYSQL_DATABASE=restaurant_space
MYSQL_USER=restaurant
MYSQL_PASSWORD=restaurant_dev_password
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_PORT=3306
# Adminer database UI (dev only)
ADMINER_PORT=8081

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_dev_password
MINIO_CONSOLE_PORT=9001
S3_PORT=9000
S3_BUCKET=restaurant-images
S3_ACCESS_KEY_ID=restaurant-app
S3_SECRET_ACCESS_KEY=restaurant_s3_dev_password

# For the future Go API running on the host. Inside Compose use http://minio:9000.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Generate browser-facing presigned URLs with S3_PUBLIC_ENDPOINT, never replace
# the hostname after signing. Bucket remains private, even for public posts.
S3_PRESIGN_TTL_SECONDS=300

# Go API
API_PORT=8080
JWT_SECRET=local-development-only-change-this-secret-32bytes
COOKIE_SECURE=false
ENABLE_API_DOCS=true
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
DB_HOST=localhost:3306
HTTP_ADDR=:8080

# Reverse proxies whose X-Forwarded-For is trusted (IPs/CIDRs, comma-separated).
# Leave empty when the API is reached directly, as in local development.
TRUSTED_PROXIES=

# Authenticated SMTP (production). Local Mailpit needs none of these.
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls
SMTP_TLS=none

# Google OAuth is optional locally. Put real credentials in .env (never in this file).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Points at the web app callback page, which forwards state/code to the API.
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# Next.js frontend
WEB_PORT=3000

# Local password reset emails are captured by Mailpit.
MAILPIT_PORT=8025
SMTP_ADDR=localhost:1025
SMTP_FROM=noreply@restaurant.local
PASSWORD_RESET_URL=http://localhost:3000/reset-password
