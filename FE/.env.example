# Browser-facing API origin (must be listed as WEB_ORIGIN's counterpart in the API CORS config).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Map tiles (optional). Empty = OpenStreetMap, which is for development only.
# Example (MapTiler): https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
